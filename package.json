{
  "name": "pr-monitor",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --filter @pr-monitor/www dev",
    "build": "bun --filter @pr-monitor/www build",
    "start": "bun --filter @pr-monitor/www start",
    "ext:dev": "bun --filter @pr-monitor/extension dev",
    "ext:build": "bun --filter @pr-monitor/extension build",
    "relay": "bun --filter @pr-monitor/ui relay",
    "format": "bun --filter '*' format",
    "format:check": "bun --filter '*' format:check",
    "lint": "bun --filter '*' lint",
    "ts": "bun --filter '*' ts"
  }
}
